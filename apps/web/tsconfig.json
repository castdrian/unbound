{
	"extends": ["../../tsconfig.base.json"],
	"compilerOptions": {
		"composite": false,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["bun", "vite/client"],
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"exclude": ["dist"]
}
